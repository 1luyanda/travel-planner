# For API usage
TRAVELPAYOUTS_TOKEN=
REST_COUNTRIES_API_KEY=

# In case of Blob storage usage
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_ACCOUNT_CONNECTION_STRING=

# For Cosmos DB usage
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=

# CORS (optional). Unset uses the backend default.
# FRONTEND_ORIGINS=http://localhost:5173

# FastAPI security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_KEY=
# Set the old key here temporarily during rotation.
API_AUTH_KEY_PREVIOUS=
APP_ENV=development
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
MAX_REQUEST_BYTES=65536

# Local account authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=false
COSMOS_USERS_CONTAINER=users
COSMOS_USER_FLIGHTS_CONTAINER=user_flights

# Proposed LLM settings. Copy to .env and fill locally. Do not commit secrets.
# create_llm_client_from_env() loads this file from the project root.
# Process environment values are not overridden.
#
# Academy Azure OpenAI chat (preferred when these four are set together):
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=replace-with-your-key
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=
#
# OpenAI-compatible alternative:
LLM_API_KEY=replace-with-your-key
LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_VERSION=
# Or OPENAI_API_KEY / OPENAI_MODEL / OPENAI_BASE_URL
